{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrivateSparta",
  "version": "0.1.1",
  "identifier": "com.privatesparta.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PrivateSparta",
        "width": 960,
        "height": 640,
        "minWidth": 840,
        "minHeight": 560,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/sing-box"],
    "resources": {
      "icons/icon.ico": "./PrivateSparta.ico",
      "resources/wintun.dll": "./wintun.dll",
      "resources/rulesets/": "rulesets/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "H. Talebi",
    "copyright": "© H. Talebi",
    "shortDescription": "PrivateSparta VPN client",
    "longDescription": "A fast, private desktop client for the PrivateSparta VPN service.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBQzAzMzQ1M0MwMjkzNzAKUldSd2t3SThSVFBBR3I1V0hUNkZocWZtQ0VtaTJCMHdnRm55bnZ1WW8yQWdRbzFuSk00by93cFEK",
      "endpoints": [
        "https://github.com/mr-physicist2002/privatesparta/releases/latest/download/latest.json"
      ]
    }
  }
}
